SECRET_KEY=generate-a-unique-local-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CSRF_TRUSTED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Set DATABASE_URL to the local MySQL URL to keep using the existing WAMP database.
# If omitted, local development uses backend/db.sqlite3.
